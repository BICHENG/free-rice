{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "free-rice config",
  "type": "object",
  "properties": {
    "subscription": {
      "type": "string",
      "description": "Clash 订阅 URL"
    },
    "clashConfig": {
      "type": "string",
      "description": "本地 Clash YAML 路径"
    },
    "gatewayPort": {
      "type": "integer",
      "const": 3425
    },
    "routerPort": {
      "type": "integer",
      "const": 7999
    },
    "defaultModel": {
      "type": "string"
    },
    "models": {
      "type": "object",
      "properties": {
        "minContextTokens": {
          "type": "integer",
          "default": 200000
        },
        "allow": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "deny": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "notifications": {
      "type": "string",
      "enum": [
        "off",
        "on"
      ]
    },
    "refreshHours": {
      "type": "integer",
      "default": 0
    }
  }
}
